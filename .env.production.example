APP_NAME="Absensi Pegawai"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://absensi.internal
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=admin_app
DB_USERNAME=admin_app
DB_PASSWORD=ubah-password-ini
DB_ROOT_PASSWORD=ubah-root-password-ini

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="absensi@internal"
MAIL_FROM_NAME="${APP_NAME}"

VLAN_IP=192.168.10.10
HTTP_PORT=8080
